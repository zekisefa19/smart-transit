{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System.Net.Http": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/smarttransit-.log",
                    "rollingInterval": "Day",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5433;Database=SmartTransitDb;Username=YOUR_POSTGRES_USER;Password=YOUR_POSTGRES_PASSWORD",
        "Redis": "localhost:6379"
    },
    "DeviceSettings": {
        "ApiKey": "YOUR_DEVICE_API_KEY"
    },
    "EmailSettings": {
        "SmtpServer": "smtp.gmail.com",
        "Port": 587,
        "SenderName": "SmartTransit Ulaşım",
        "SenderEmail": "YOUR_SENDER_EMAIL@gmail.com",
        "Password": "YOUR_GMAIL_APP_PASSWORD"
    },
    "LlmSettings": {
        "Provider": "Ollama",
        "Model": "qwen2.5:3b",
        "OllamaEndpoint": "http://localhost:11434"
    }
}